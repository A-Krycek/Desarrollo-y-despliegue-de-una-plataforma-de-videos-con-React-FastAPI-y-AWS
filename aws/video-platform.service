[Unit]
Description=FastAPI Video Platform API Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/video-platform-aws/backend
EnvironmentFile=/home/ubuntu/video-platform-aws/backend/.env
ExecStart=/home/ubuntu/video-platform-aws/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
