# =======================================================================
# CONFIGURACIÓN DE EJEMPLO PARA EL BACKEND (FastAPI + AWS)
# Duplica este archivo como .env y completa los valores con tus credenciales
# =======================================================================
ENVIRONMENT=production

# Base de Datos Relacional (Amazon RDS PostgreSQL)
# Para producción en RDS:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:5432/postgres
# Para desarrollo local sin RDS:
# DATABASE_URL=sqlite:///./video_platform.db

# Amazon S3
AWS_REGION=us-east-1
S3_BUCKET_VIDEOS=YOUR_VIDEO_BUCKET
S3_BUCKET_THUMBNAILS=YOUR_THUMBNAIL_BUCKET

# NOTA DE SEGURIDAD AWS IAM:
# En la instancia EC2, Boto3 utiliza automáticamente el IAM Role (Instance Profile).
# Deja estas variables vacías para no quemar claves secretas en el servidor.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Seguridad y Autenticación JWT
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Control de Acceso entre Orígenes (CORS)
# Especifica la URL pública de la SPA en S3 y tu entorno local (sin comodín '*')
CORS_ORIGINS=http://YOUR_FRONTEND_S3_URL,http://localhost:5173

# Parámetros del Servidor EC2
HOST=0.0.0.0
PORT=8000
